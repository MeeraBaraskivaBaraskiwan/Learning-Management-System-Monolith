# ----------------------------------------------------
#   Maven / Gradle / Java
# ----------------------------------------------------
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

build/
!**/src/main/**/build/
!**/src/test/**/build/

# Ignore common build artifacts
*.class
*.jar
*.war
*.ear

# Logs and temporary files
*.log
logs/
*.tmp
*.swp
*.swo

# ----------------------------------------------------
#   IDEs
# ----------------------------------------------------

# --- Spring Tool Suite / Eclipse ---
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# --- IntelliJ IDEA ---
.idea/
*.iws
*.iml
*.ipr
out/

# --- NetBeans ---
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# --- VS Code ---
.vscode/

# ----------------------------------------------------
#   OS-specific
# ----------------------------------------------------
.DS_Store
Thumbs.db
*.bak

# ----------------------------------------------------
#   Other
# ----------------------------------------------------
HELP.md
*.env
.env.local
.env.*.local
